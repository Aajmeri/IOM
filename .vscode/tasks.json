{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/IOM.Api/IOM.Api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/IOM.Api/IOM.Api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/IOM.Api/IOM.Api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "ng serve",
            "command": "npm",
            "type": "process",
            "args": [
                "run",
                "start",
                "--prefix",
                "${workspaceFolder}/IOM.Api/ClientApp"
            ],
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "ng build",
            "command": "npm",
            "type": "process",
            "args": [
                "run",
                "build",
                "--prefix",
                "${workspaceFolder}/IOM.Api/ClientApp"
            ],
            "problemMatcher": "$tsc",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "ng build:watch",
            "command": "npm",
            "type": "process",
            "args": [
                "run",
                "watch",
                "--prefix",
                "${workspaceFolder}/IOM.Api/ClientApp"
            ],
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
